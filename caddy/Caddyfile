jarvis-bielenki.duckdns.org {
    encode gzip
    request_body {
        max_size 128KB
    }
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        -Server
    }
    handle_path /voice/* {
        reverse_proxy voice:8010
    }
    handle {
        reverse_proxy jarvis:8000
    }
}
